# OpenVario input configuration: the quick menu
# (mode QuickMenu, formerly RemoteStick).

# -------------
# mode=QuickMenu
# -------------

mode=QuickMenu
type=key
data=0
event=Calculator
event=Mode default
label=Task
location=0

mode=QuickMenu
type=key
data=0
event=AdjustWaypoint previousarm
label=$(WaypointPreviousArm)
