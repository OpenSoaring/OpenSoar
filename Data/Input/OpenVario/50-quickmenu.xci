# The end of the list: XCSoar's buttons after its Quit (44) move up by
# one, the audio menu follows (60-audio.xci, 46), then the power
# buttons, and Quit is always the last one, so it is found in the
# same corner of the list everywhere.  All of them open the power
# dialog; the event names the button that has the focus there.
mode=QuickMenu
type=key
data=0
event=Mode weather
label=Forecast\nControls
location=44

# The download from Recorder 1 and 2 of the logger settings.
mode=QuickMenu
type=key
data=0
event=RecorderDownload 1
event=Mode default
label=Recorder 1\nDownload$(CheckRecorder1)
location=33

mode=QuickMenu
type=key
data=0
event=RecorderDownload 2
event=Mode default
label=Recorder 2\nDownload$(CheckRecorder2)
location=34

# The log book, at the place of the InfoBox arrange mode of XCSoar,
# which this version does not have.
mode=QuickMenu
