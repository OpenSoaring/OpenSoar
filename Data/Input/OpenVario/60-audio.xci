# OpenVario input configuration: the vario audio menu
# for the PCM mixer that OpenSoar controls on the OpenVario.

# -------------
# Define VarioAudioMenu buttons for Audio app 
# - the PCM mixer controlled by OpenSoar 
# -------------

mode=VarioAudioMenu
type=key
data=DOWN
event=Sounds quieter
label=VOL - (DOWN)$(CheckAudioQuiet)
location=1

mode=VarioAudioMenu
type=key
# data=M  # on RemoteStick
data=F1
event=Sounds toggle
label=VOL On/Off\n(press M)
location=2

mode=VarioAudioMenu
type=key
data=UP
event=Sounds louder
label=VOL + (UP)$(CheckAudioLoud)
location=3

mode=VarioAudioMenu
type=key
data=RETURN
event=Mode default
label=Volume:\n$(AudioVolume)
location=4

mode=VarioAudioMenu
type=key
data=LEFT
event=MacCready down
label=MC-\n(LEFT)
location=6

mode=VarioAudioMenu
type=key
data=RIGHT
event=MacCready up
label=MC+\n(RIGHT)
location=7

mode=VarioAudioMenu
type=key
data=RETURN
event=Mode default
label=MC: $(MC_Value)
location=8

mode=VarioAudioMenu
type=key
data=ESCAPE
event=Mode default
label=BACK (ESC)
location=9

mode=default QuickMenu
type=key
data=M
event=Mode VarioAudioMenu 

mode=QuickMenu
type=key
data=0
event=Mode VarioAudioMenu 
label=Audio Menu
location=58

