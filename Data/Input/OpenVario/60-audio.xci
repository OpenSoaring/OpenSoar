# OpenVario input configuration: the menu "Audio / MC".

# -------------
# The menu "Audio / MC": the audio dialog and the MacCready value.
# The volumes used to be stepped here with "Sounds quieter" and
# "Sounds louder", which the program never implemented, so the
# buttons did nothing.  The audio dialog (event Audio) shows the
# master and the vario volume as bars, mutes the vario and switches
# between the program's own vario sound and variod, and every change
# is heard at once.
# -------------

mode=VarioAudioMenu
type=key
# data=M  # on RemoteStick
data=F1
event=Mode default
event=Audio
label=Audio\n(F1)
location=2

mode=VarioAudioMenu
type=key
data=LEFT
event=MacCready down
label=MC-\n(LEFT)
location=6

mode=VarioAudioMenu
type=key
data=RIGHT
event=MacCready up
label=MC+\n(RIGHT)
location=7

mode=VarioAudioMenu
type=key
data=RETURN
event=Mode default
label=MC: $(MC_Value)
location=8

mode=VarioAudioMenu
type=key
data=ESCAPE
event=Mode default
label=BACK (ESC)
location=9

mode=default QuickMenu
type=key
data=M
event=Mode VarioAudioMenu 

mode=QuickMenu
type=key
data=0
event=Mode default
event=Audio
label=Audio
location=46

