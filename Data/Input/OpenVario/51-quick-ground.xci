# The quick menu before the flight (mode QuickGround), used by the
# quick menu style "OpenSoar".
#
# "location" is the place in three columns (portrait), counted row by
# row from the top left.  "landscape" is the place in five columns; it
# keeps the same picture in the middle of the wider screen.  An empty
# place stays an empty cell, so the other buttons keep their places.
# The focus starts on the button with "center=yes".
#
#   location (portrait)     landscape
#    1   2   3               2   3   4
#    4   5   6               7   8   9
#    7   8   9              12  13  14
#   10  11  12              17  18  19
#   13  14  15              22  23  24
#
# The buttons of this list in portrait:
#
#    1 -                2 Audio / MC       3 -
#    4 -                5 Flight Setup     6 -
#    7 Weather          8 Configuration    9 Map Display
#   10 Pan Mode        11 Task Manager    12 Quick Guide
#   13 Replay          14 Devices         15 Data Management
#
# 1, 3 and 4 stay empty for now; the list can grow.  6 (Forecast
# Controls in the OpenSoar list) is left out here: the OpenVario
# configuration has no key bindings for the weather mode yet.

mode=QuickGround
type=key
data=0
event=Mode VarioAudioMenu
label=Audio / MC
location=2
landscape=3

mode=QuickGround
type=key
data=0
event=Setup Basic
event=Mode default
label=Flight Setup
location=5
landscape=8

mode=QuickGround
type=key
data=0
event=Weather
event=Mode default
label=Weather
location=7
landscape=12

mode=QuickGround
type=key
data=0
event=Setup System
event=Mode default
label=Configuration
location=8
landscape=13
center=yes

mode=QuickGround
type=key
data=0
event=MapDisplay
label=Map\nDisplay
location=9
landscape=14


mode=QuickGround
type=key
data=0
event=Pan on
label=Pan Mode
location=10
landscape=17

mode=QuickGround
type=key
data=0
event=Calculator
event=Mode default
label=Task Manager
location=11
landscape=18

mode=QuickGround
type=key
data=0
event=QuickGuide
event=Mode default
label=Quick Guide
location=12
landscape=19

mode=QuickGround
type=key
data=0
event=Setup Replay
event=Mode default
label=Replay$(CheckReplay)
location=13
landscape=22

mode=QuickGround
type=key
data=0
event=Device list
event=Mode default
label=Devices
location=14
landscape=23

mode=QuickGround
type=key
data=0
event=DataManagement
event=Mode default
label=Data Management
location=15
landscape=24
