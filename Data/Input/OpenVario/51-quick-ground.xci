# The quick menu before the flight (mode QuickGround), used by the
# quick menu style "OpenSoar".
#
# "location" is the place in three columns, counted row by row from
# the top left.  A wider screen (landscape) shows the same picture in
# its middle.  An empty place stays an empty cell, so the other
# buttons keep their places.  The focus starts on the button with
# "center=yes".  A button can get a place of its own for a wider
# screen with "landscape=C:N": place N counted in C columns.
#
#    1 -                2 Audio / MC       3 -
#    4 -                5 Flight Setup     6 -
#    7 Weather          8 Configuration    9 Map Display
#   10 Pan Mode        11 Task Manager    12 Quick Guide
#   13 Replay          14 Devices         15 Data Management
#
# 1, 3 and 4 stay empty for now; the list can grow.  6 (Forecast
# Controls in the OpenSoar list) is left out here: the OpenVario
# configuration has no key bindings for the weather mode yet.

mode=QuickGround
type=key
data=0
event=Mode VarioAudioMenu
label=Audio / MC
location=2

mode=QuickGround
type=key
data=0
event=Setup Basic
event=Mode default
label=Flight Setup
location=5

mode=QuickGround
type=key
data=0
event=Weather
event=Mode default
label=Weather
location=7

mode=QuickGround
type=key
data=0
event=Setup System
event=Mode default
label=Configuration
location=8
center=yes

mode=QuickGround
type=key
data=0
event=MapDisplay
label=Map\nDisplay
location=9


mode=QuickGround
type=key
data=0
event=Pan on
label=Pan Mode
location=10

mode=QuickGround
type=key
data=0
event=Calculator
event=Mode default
label=Task Manager
location=11

mode=QuickGround
type=key
data=0
event=QuickGuide
event=Mode default
label=Quick Guide
location=12

mode=QuickGround
type=key
data=0
event=Setup Replay
event=Mode default
label=Replay$(CheckReplay)
location=13

mode=QuickGround
type=key
data=0
event=Device list
event=Mode default
label=Devices
location=14

mode=QuickGround
type=key
data=0
event=DataManagement
event=Mode default
label=Data Management
location=15
