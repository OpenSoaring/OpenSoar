# The submenu "Map Display" of the quick menu (mode MapDisplay): the
# switches of the map display, which would otherwise crowd the quick
# menu.  The quick menu opens it with "event=QuickMenu MapDisplay".
#
# Locations are ranks, as in the phase lists: 1 is the centre, where
# the focus starts, 2 above, 3 left, 4 right, 5 below, 6 two above,
# 7 two below, 8 and 9 the upper corners.

mode=MapDisplay
type=key
data=0
event=AirSpace toggle
label=Airspace\n$(AirspaceToggleActionName)
location=1

mode=MapDisplay
type=key
data=0
event=AirspaceLabels show
event=AirspaceLabels toggle
label=Airspace Labels\n$(AirspaceLabelsToggleActionName)$(CheckAirspace)
location=2

mode=MapDisplay
type=key
data=0
event=DeclutterLabels show
event=DeclutterLabels toggle
label=Labels\n$(MapLabelsToggleActionName)
location=3

mode=MapDisplay
type=key
data=0
event=SnailTrail show
event=SnailTrail toggle
label=Trail\n$(SnailTrailToggleName)
location=4

mode=MapDisplay
type=key
data=0
event=Zoom auto show
event=Zoom auto toggle
label=Zoom\n$(ZoomAutoToggleActionName)
location=5

mode=MapDisplay
type=key
data=0
event=Page settings
label=Page\nSettings
location=6

mode=MapDisplay
type=key
data=0
event=DistanceRings show
event=DistanceRings toggle
label=Distance Rings\n$(DistanceRingsToggleActionName)
location=7

mode=MapDisplay
type=key
data=0
event=FLARMRadar gauge
label=FLARM Gauge\n$(FlarmDispToggleActionName)
location=8

mode=MapDisplay
type=key
data=0
event=ThermalAssistant toggle
label=Thermal Assistant\n$(ThermalAssistantToggleActionName)
location=9
