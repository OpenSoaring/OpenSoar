# The quick menu after the landing (mode QuickAfter), used by the
# quick menu style "Dynamic".
#
# "location" is the place in three columns, counted row by row from
# the top left.  A wider screen (landscape) shows the same picture in
# its middle.  An empty place stays an empty cell, so the other
# buttons keep their places.  The focus starts on the button with
# "center=yes".  A button can get a place of its own for a wider
# screen with "landscape=C:N": place N counted in C columns.
#
#    1 Upload           2 Recorder 2       3 Configuration
#    4 -                5 Recorder 1       6 Log book
#    7 Barograph        8 Analysis         9 Flight Overview
#   10 -               11 -               12 -
#   13 -               14 -               15 -
#
# 5 and 2 download from Recorder 1 and 2 of the logger settings; they
# are inactive while no device is set or it is not connected.  The
# other empty places stay empty for now.
#
# 18 Quit, in a row of its own below the block, on the right: the
# last button, as in the complete quick menu.

mode=QuickAfter
type=key
data=0
event=UploadIGCFile
event=Mode default
label=Upload
location=1

mode=QuickAfter
type=key
data=0
event=Setup System
event=Mode default
label=Configuration
location=3


mode=QuickAfter
type=key
data=0
event=RecorderDownload 2
event=Mode default
label=Recorder 2\nDownload$(CheckRecorder2)
location=2

mode=QuickAfter
type=key
data=0
event=RecorderDownload 1
event=Mode default
label=Recorder 1\nDownload$(CheckRecorder1)
location=5

# The log book, to look at the flight just recorded (and the ones
# read from the downloaded files).
mode=QuickAfter
type=key
data=0
event=Logbook
event=Mode default
label=Log book
location=6

mode=QuickAfter
type=key
data=0
event=Analysis barograph
event=Mode default
label=Barograph
location=7

mode=QuickAfter
type=key
data=0
event=Analysis
event=Mode default
label=Analysis
location=8
center=yes

mode=QuickAfter
type=key
data=0
event=Analysis contest
event=Mode default
label=Flight\nOverview
location=9

mode=QuickAfter
type=key
data=0
event=Exit system
event=Mode default
label=Quit
location=18
