# OpenSoar changes to the XCSoar quick menu (mode QuickMenu, which
# XCSoar still calls RemoteStick).
#
# Read after Data/Input/default.xci; an entry replaces the XCSoar
# entry at the same location.  Empty locations do not show, so an
# entry without an event removes a button without moving the others.

# The switches of the map display move into the dialog "Map Display"
# (event MapDisplay), so the quick menu stays clear: the terrain and
# topography toggles (the page settings with the base map take their
# place there), labels, trail, airspace labels, auto zoom and distance
# rings.  The airspace toggle goes there as well, and the dialog takes
# its place in the centre.  The FLARM radar and the thermal assistant
# pages leave the quick menu; they stay in the menu bar and on their
# keys, and the dialog switches their small gauges.
mode=QuickMenu
type=key
data=0
label=
location=7

mode=QuickMenu
type=key
data=0
label=
location=8

