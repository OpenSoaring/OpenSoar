# OpenSoar keys on top of Data/Input/default.xci: they work on the
# map, in pan mode and with a menu bar open, like the same keys of the
# OpenVario configuration (Data/Input/OpenVario/20-keys.xci).

# Q quits, X switches off: both open the power dialog, with the focus
# on the button the key stands for, so RETURN confirms.  Where the
# device cannot switch off (a desktop), X leaves the focus on Quit.
mode=default pan Nav1 Nav2 Display1 Display2 Config1 Config2 Config3 Info1 Info2 Info3 Menu Vario1 Vario2
type=key
data=Q
event=Exit system
event=Mode default

mode=default pan Nav1 Nav2 Display1 Display2 Config1 Config2 Config3 Info1 Info2 Info3 Menu Vario1 Vario2
type=key
data=X
event=Exit shutdown
event=Mode default

# The STF switch of the remote stick and other instruments: S speed to
# fly, V vario, T toggles.  It sets the audio vario to that mode and
# passes it to the devices that have such a switch (Larus, FreeVario).
mode=default pan Nav1 Nav2 Display1 Display2 Config1 Config2 Config3 Info1 Info2 Info3 Menu Vario1 Vario2
type=key
data=S
event=STFSwitch STF

mode=default pan Nav1 Nav2 Display1 Display2 Config1 Config2 Config3 Info1 Info2 Info3 Menu Vario1 Vario2
type=key
data=V
event=STFSwitch Vario

mode=default pan Nav1 Nav2 Display1 Display2 Config1 Config2 Config3 Info1 Info2 Info3 Menu Vario1 Vario2
type=key
data=T
event=STFSwitch toggle

# XCSoar has S and T for the text size; the switch keeps those letters,
# the text size moves to U (larger) and D (smaller)
mode=default
type=key
data=U
event=TextSize up

mode=default
type=key
data=D
event=TextSize down
