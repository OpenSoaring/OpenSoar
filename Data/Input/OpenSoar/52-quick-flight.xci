# The quick menu in flight (mode QuickFlight).
#
# Locations 1 to 15 are ranks in the framed block of the style
# "Dynamic": 1 is the centre, where the focus starts, 2 above, 3 left,
# 4 right, 5 below, 6 two above, 7 two below, 8 and 9 the upper
# corners, 10 and 11 beside 2, 12 and 13 beside 5, 14 and 15 the lower
# corners:
#
#    8   6   9
#   10   2  11
#    3   1   4
#   12   5  13
#   14   7  15
#
# 11 to 13 stay empty for now; the list can grow.

mode=QuickFlight
type=key
data=0
event=Setup Alternates
event=Mode default
label=Alternates$(CheckWaypointFile)
location=1

mode=QuickFlight
type=key
data=0
event=Setup Basic
event=Mode default
label=Flight Setup
location=2

mode=QuickFlight
type=key
data=0
event=AdjustWaypoint previousarm
label=$(WaypointPreviousArm)
location=3

mode=QuickFlight
type=key
data=0
event=AdjustWaypoint nextarm
label=$(WaypointNextArm)
location=4

mode=QuickFlight
type=key
data=0
event=WaypointDetails select
event=Mode default
label=Waypoint List$(CheckWaypointFile)
location=5

mode=QuickFlight
type=key
data=0
event=Mode mc
label=MacCready
location=6

mode=QuickFlight
type=key
data=0
event=Calculator
event=Mode default
label=Task Manager
location=7

mode=QuickFlight
type=key
data=0
event=Analysis
event=Mode default
label=Analysis
location=8

mode=QuickFlight
type=key
data=0
event=Setup System
event=Mode default
label=Configuration
location=9

mode=QuickFlight
type=key
data=0
event=ResetTask
event=StatusMessage Task restarted
label=Task\nRestart
location=14

mode=QuickFlight
type=key
data=0
event=Mode default
event=StatusMessage Pilot event announced
event=Logger note PEV
event=PilotEvent
label=Pilot Event Announce
location=15

mode=QuickFlight
type=key
data=0
event=MapDisplay
label=Map\nDisplay
location=10
