# The quick menu after the landing (mode QuickAfter), used by the
# quick menu style "OpenSoar".
#
# "location" is the place in three columns (portrait), counted row by
# row from the top left.  "landscape" is the place in five columns; it
# keeps the same picture in the middle of the wider screen.  An empty
# place stays an empty cell, so the other buttons keep their places.
# The focus starts on the button with "center=yes".
#
#   location (portrait)     landscape
#    1   2   3               2   3   4
#    4   5   6               7   8   9
#    7   8   9              12  13  14
#   10  11  12              17  18  19
#   13  14  15              22  23  24
#
# The buttons of this list in portrait:
#
#    1 Upload           2 -                3 Configuration
#    4 -                5 -                6 -
#    7 Barograph        8 Analysis         9 Flight Overview
#   10 -               11 -               12 -
#   13 -               14 -               15 -
#
# Still to come: 5 and 2 download the flights of logger 1 and 2.
# The other empty places stay empty for now.

mode=QuickAfter
type=key
data=0
event=UploadIGCFile
event=Mode default
label=Upload
location=1
landscape=2

